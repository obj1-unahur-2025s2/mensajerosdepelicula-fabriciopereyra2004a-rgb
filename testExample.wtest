import example.pepita
import mensajeros.*

describe "group of tests for pepita" {
/*

1. Que roberto (90kg) puede llevar un paquete que está pago en un camión que tiene un acoplado.
2. Que neo con crédito no puede llevar un paquete que no está pago a la matrix.

*/
  test "pepita has initial energy" {
    assert.equals(100, pepita.energy())
  }

  test "Que roberto (90kg) puede llevar un paquete que está pago en un camión que tiene un acoplado."{
    roberto.cambiarPeso(90)
    roberto.cambiarVehiculo(camion)
    camion.acoplados(1)
    paquete.pagar()
    paquete.asignarDestino(puenteDeBrooklyn)
    assert.that(paquete.puedeSerEntregado(roberto))
  }

}